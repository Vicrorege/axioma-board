# AxiomaBoard Backend Configuration Template
HOST=0.0.0.0
PORT=8200

# OmniRoute or OpenAI-compatible LLM endpoint (optional, enables AI math actions & reasoning)
OMNI_BASE_URL=http://localhost:8400/v1
OMNI_API_KEY=your_api_key_here
OMNI_MODEL=auto/fast

# SMTP Email Verification Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_password_here
SMTP_FROM=noreply@example.com
SMTP_SSL=true
